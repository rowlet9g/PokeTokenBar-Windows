<Window x:Class="PokeTokenBar.Windows.FloatingPetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Manual">
    <Border x:Name="PetHitSurface"
            Padding="8"
            Background="#01000000"
            CornerRadius="12"
            Cursor="Hand"
            MouseLeftButtonDown="PetHitSurface_OnMouseLeftButtonDown"
            MouseRightButtonDown="PetHitSurface_OnMouseRightButtonDown">
        <Grid x:Name="PetVisualRoot"
              RenderOptions.BitmapScalingMode="NearestNeighbor">
            <Image x:Name="PetImage"
                   Stretch="Uniform"
                   SnapsToDevicePixels="True" />
            <Viewbox x:Name="EggVisual" Stretch="Uniform">
                <Canvas Width="100" Height="112">
                    <Path Fill="#FF171A21"
                          Stroke="#FFFF5E46"
                          StrokeThickness="7"
                          StrokeLineJoin="Round"
                          Data="M 50,7 C 28,7 12,42 12,73 C 12,95 27,105 50,105 C 73,105 88,95 88,73 C 88,42 72,7 50,7 Z" />
                    <Path Stroke="#FFFF5E46"
                          StrokeThickness="7"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Data="M 27,68 L 43,53 L 57,69 L 72,54" />
                </Canvas>
            </Viewbox>
            <TextBlock x:Name="FallbackText"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#FF7DD3FC"
                       FontSize="32"
                       FontWeight="Bold"
                       Text="?"
                       Visibility="Collapsed" />
        </Grid>
    </Border>
</Window>
