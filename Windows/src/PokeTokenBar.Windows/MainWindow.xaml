<Window x:Class="PokeTokenBar.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PokeTokenBar"
        Width="380"
        Height="500"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Padding="22"
            Background="#FF171A21"
            BorderBrush="#FF343A46"
            BorderThickness="1"
            CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal">
                    <Button x:Name="RefreshButton"
                            Width="30"
                            Height="30"
                            Margin="0,0,4,0"
                            Click="RefreshButton_OnClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#FFAEB7C7"
                            FontSize="18"
                            ToolTip="Refresh Codex usage"
                            Content="&#x21BB;" />
                    <Button Width="30"
                            Height="30"
                            Click="HideButton_OnClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#FFAEB7C7"
                            FontSize="18"
                            Content="&#x2715;" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Foreground="White"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Text="PokeTokenBar" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="#FF7DD3FC"
                               FontSize="12"
                               Text="Windows port · Codex usage" />
                </StackPanel>
            </DockPanel>

            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Grid Width="96"
                      Height="96"
                      HorizontalAlignment="Center">
                    <Grid x:Name="EggVisual">
                        <Path Fill="#FF1B1F27"
                          Stroke="#FFFF5A3C"
                          StrokeThickness="4"
                          Data="M 48,3 C 28,3 13,36 13,63 C 13,84 27,93 48,93 C 69,93 83,84 83,63 C 83,36 68,3 48,3 Z">
                            <Path.Effect>
                                <DropShadowEffect BlurRadius="10"
                                                  Color="#FFFF4F38"
                                                  Opacity="0.7"
                                                  ShadowDepth="0" />
                            </Path.Effect>
                        </Path>
                        <Path Stroke="#FFFF5A3C"
                          StrokeThickness="5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Data="M 26,57 L 38,47 L 48,58 L 58,45 L 71,56" />
                    </Grid>
                    <Image x:Name="PokemonImage"
                           Width="96"
                           Height="96"
                           Stretch="Uniform"
                           Visibility="Collapsed"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Grid>
                <TextBlock x:Name="CompanionTitleText"
                           Margin="0,5,0,0"
                           HorizontalAlignment="Center"
                           Foreground="#FFFF806B"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Text="새 알 · 0%" />
                <ProgressBar x:Name="CompanionProgressBar"
                             Width="180"
                             Height="6"
                             Margin="0,6,0,0"
                             Background="#FF343A46"
                             Foreground="#FFFF5A3C"
                             Maximum="1"
                             Value="0" />
                <TextBlock x:Name="CompanionProgressText"
                           Margin="0,5,0,0"
                           HorizontalAlignment="Center"
                           Foreground="#FF8F98A8"
                           FontSize="10"
                           Text="첫 사용량 동기화 후 부화를 시작합니다" />
                <TextBlock x:Name="TokenValueText"
                           Margin="0,12,0,0"
                           HorizontalAlignment="Center"
                           Foreground="White"
                           FontFamily="Consolas"
                           FontSize="34"
                           FontWeight="Bold"
                           Text="0" />
                <TextBlock x:Name="ExactTokenValueText"
                           Margin="0,4,0,0"
                           HorizontalAlignment="Center"
                           Foreground="#FF7DD3FC"
                           FontFamily="Consolas"
                           FontSize="12"
                           Text="0" />
                <TextBlock x:Name="StatusText"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           Foreground="#FFAEB7C7"
                           Text="Codex 로그 연결 준비 중" />
                <StackPanel Margin="0,18,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock HorizontalAlignment="Center"
                                   Foreground="#FF7D8797"
                                   FontSize="11"
                                   Text="THIS WEEK" />
                        <TextBlock x:Name="WeekValueText"
                                   Margin="0,3,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="White"
                                   FontFamily="Consolas"
                                   FontSize="16"
                                   Text="0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center"
                                   Foreground="#FF7D8797"
                                   FontSize="11"
                                   Text="THIS MONTH" />
                        <TextBlock x:Name="MonthValueText"
                                   Margin="0,3,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="White"
                                   FontFamily="Consolas"
                                   FontSize="16"
                                   Text="0" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="2">
                <Border Height="1" Margin="0,0,0,14" Background="#FF343A46" />
                <TextBlock Foreground="#FF7D8797"
                           FontSize="11"
                           Text="Windows data directory" />
                <TextBlock x:Name="StoragePathText"
                           Margin="0,4,0,0"
                           Foreground="#FFAEB7C7"
                           FontFamily="Consolas"
                           FontSize="11"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
