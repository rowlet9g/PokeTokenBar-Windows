<Window x:Class="PokeTokenBar.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PokeTokenBar"
        Width="420"
        Height="580"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <Style x:Key="ModernToggleCheckBox" TargetType="CheckBox">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="42" Height="22">
                            <Border x:Name="Track"
                                    Background="#FFE5E5EA"
                                    BorderBrush="#FFC7C7CC"
                                    BorderThickness="1"
                                    CornerRadius="11" />
                            <Ellipse x:Name="Knob"
                                     Width="16"
                                     Height="16"
                                     Margin="3"
                                     HorizontalAlignment="Left"
                                     Fill="#FF575B63" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#FF007AFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#FF2683AA" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#FF007AFF" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Fill" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="Foreground" Value="#FF30333A" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Margin="3,1"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FFE5E5EA" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FFD9E9FF" />
                                <Setter Property="Foreground" Value="#FF007AFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FF202124" />
            <Setter Property="Background" Value="#FFF9FAFB" />
            <Setter Property="BorderBrush" Value="#FFC7C7CC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ModernComboBoxItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Foreground="#FF202124"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBorder"
                                                Background="#FFF9FAFB"
                                                BorderBrush="#FFC7C7CC"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Grid>
                                                <ContentPresenter Margin="11,0,32,0"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <Path Width="9"
                                                      Height="5"
                                                      Margin="0,0,11,0"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Data="M 0,0 L 4.5,4 L 9,0"
                                                      Stroke="#FF81858C"
                                                      StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#FF007AFF" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ComboBorder" Property="Background" Value="#FFEAF3FF" />
                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#FF007AFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,4,0,0"
                                        Padding="2"
                                        Background="#FFF9FAFB"
                                        BorderBrush="#FFC7C7CC"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <ScrollViewer MaxHeight="220">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FF202124" />
            <Setter Property="Background" Value="#FFE5E5EA" />
            <Setter Property="BorderBrush" Value="#FFC7C7CC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="#FFE0ECFA" />
                                <Setter TargetName="ActionBorder" Property="BorderBrush" Value="#FF007AFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="#FFD9E9FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernScrollThumb" TargetType="Thumb">
            <Setter Property="Background" Value="#FFC7C7CC" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Margin="1"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#FF647386" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#FF007AFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernVerticalScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Focusable="False"
                                                  Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Focusable="False"
                                                  Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar"
               BasedOn="{StaticResource ModernVerticalScrollBar}" />
    </Window.Resources>
    <Border Padding="14"
            Background="#FFF9FAFB"
            BorderBrush="#FFD9DADD"
            BorderThickness="1"
            CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,10" MouseLeftButtonDown="HeaderDragRegion_OnMouseLeftButtonDown">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="TokensTabButton" Content="사용량 상세" Click="TokensTabButton_OnClick" Padding="7,4" Style="{StaticResource ModernActionButton}" />
                    <Button x:Name="SettingsTabButton" Content="⚙" ToolTip="설정" Click="SettingsTabButton_OnClick" Padding="9,4" Margin="4,0" Style="{StaticResource ModernActionButton}" />
                    <Button x:Name="RefreshButton" Content="↻" ToolTip="새로고침" Click="RefreshButton_OnClick" Padding="9,4" Style="{StaticResource ModernActionButton}" />
                    <Button Content="—" ToolTip="트레이로 숨기기" Click="HideButton_OnClick" Padding="8,4" Style="{StaticResource ModernActionButton}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PokeTokenBar" FontSize="12" Foreground="#FF575B63" />
                    <TextBlock x:Name="HeaderVersionText" Margin="4,0,0,0" FontSize="10"
                               VerticalAlignment="Center" Foreground="#FF9A9EA6" />
                </StackPanel>
            </DockPanel>
            <Border Grid.Row="1" Background="#FFE5E5EA" CornerRadius="8" Padding="2" Margin="0,0,0,14">
                <UniformGrid Columns="4">
                    <Button x:Name="HomeTabButton" Content="홈" Click="HomeTabButton_OnClick" Style="{StaticResource ModernActionButton}" Height="30" BorderThickness="0" />
                    <Button x:Name="ShopTabButton" Content="상점" Click="ShopTabButton_OnClick" Style="{StaticResource ModernActionButton}" BorderThickness="0" />
                    <Button x:Name="BagTabButton" Content="가방" Click="BagTabButton_OnClick" Style="{StaticResource ModernActionButton}" BorderThickness="0" />
                    <Button x:Name="PokedexTabButton" Content="컬렉션" Click="PokedexTabButton_OnClick" Style="{StaticResource ModernActionButton}" BorderThickness="0" />
                </UniformGrid>
            </Border>

            <ScrollViewer x:Name="HomeView" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="0,0,5,6">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid x:Name="CompanionVisualContainer"
                      Width="96"
                      Height="96"
                      HorizontalAlignment="Center">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="CompanionIdleTranslate" />
                    </Grid.RenderTransform>
                    <Grid x:Name="EggVisual">
                        <Path Fill="#FF1B1F27"
                          Stroke="#FFFF5A3C"
                          StrokeThickness="4"
                          Data="M 48,3 C 28,3 13,36 13,63 C 13,84 27,93 48,93 C 69,93 83,84 83,63 C 83,36 68,3 48,3 Z">
                            <Path.Effect>
                                <DropShadowEffect BlurRadius="10"
                                                  Color="#FFFF4F38"
                                                  Opacity="0.7"
                                                  ShadowDepth="0" />
                            </Path.Effect>
                        </Path>
                        <Path Stroke="#FFFF5A3C"
                          StrokeThickness="5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Data="M 26,57 L 38,47 L 48,58 L 58,45 L 71,56" />
                    </Grid>
                    <Image x:Name="PokemonImage"
                           Width="96"
                           Height="96"
                           Stretch="Uniform"
                           Visibility="Collapsed"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Grid>
                  <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <WrapPanel VerticalAlignment="Center">
                      <TextBlock x:Name="CompanionTitleText" FontSize="17" FontWeight="SemiBold" Foreground="#FF202124"/>
                      <Border x:Name="RarityBadge" CornerRadius="8" Padding="6,2" Margin="6,0,0,0" Background="#FF007AFF"><TextBlock x:Name="RarityText" Foreground="White" FontSize="10"/></Border>
                    </WrapPanel>
                    <TextBlock x:Name="CompanionIdentityText" Margin="0,5,0,0" Foreground="#FF575B63" FontSize="11" TextWrapping="Wrap"/>
                    <ProgressBar x:Name="CompanionProgressBar" Height="7" Margin="0,8,0,0" Maximum="1" Foreground="#FFFF9500" Background="#FFD9DADD" BorderThickness="0"/>
                    <TextBlock x:Name="CompanionProgressText" Margin="0,7,0,0" Foreground="#FF81858C" FontSize="11" TextWrapping="Wrap"/>
                    <TextBlock x:Name="CompanionMoodText" Margin="0,6,0,0" Foreground="#FF575B63" FontSize="11" TextWrapping="Wrap"/>
                  </StackPanel>
                </Grid>
                <StackPanel x:Name="EvolutionLinePanel" Orientation="Horizontal" Margin="0,14,0,8"/>
                <Border Height="1" Background="#FFD9DADD" Margin="0,10,0,14"/>
                <TextBlock Text="오늘 사용한 토큰" Foreground="#FF81858C" FontSize="12"/>
                <DockPanel Margin="0,6,0,0">
                  <TextBlock x:Name="TodayCostText" DockPanel.Dock="Right" Foreground="#FF575B63" FontSize="14" VerticalAlignment="Bottom" Margin="6,0,0,6"/>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TokenValueText" Foreground="#FF202124" FontSize="32" FontWeight="Bold"/>
                    <TextBlock x:Name="ExactTokenValueText" Foreground="#FF575B63" FontSize="12" Margin="10,0,0,6" VerticalAlignment="Bottom"/>
                  </StackPanel>
                </DockPanel>
                <WrapPanel Margin="0,8,0,0">
                  <TextBlock Text="이번 주  " Foreground="#FF81858C"/>
                  <TextBlock x:Name="WeekValueText" Foreground="#FF202124" FontWeight="SemiBold"/>
                  <TextBlock x:Name="WeekCostText" Foreground="#FF575B63" Margin="5,0,14,0"/>
                  <TextBlock Text="이번 달  " Foreground="#FF81858C"/>
                  <TextBlock x:Name="MonthValueText" Foreground="#FF202124" FontWeight="SemiBold"/>
                  <TextBlock x:Name="MonthCostText" Foreground="#FF575B63" Margin="5,0,0,0"/>
                </WrapPanel>
                <TextBlock x:Name="StatusText" Margin="0,12,0,0" Foreground="#FF81858C" FontSize="10" TextWrapping="Wrap"/>
                <StackPanel x:Name="RateLimitPanel" Margin="0,14,0,0" Visibility="Collapsed">
                  <TextBlock Text="공식 사용량 한도" Foreground="#FF202124" FontWeight="SemiBold"/>
                  <TextBlock x:Name="RateLimitStatusText" Foreground="#FF81858C" FontSize="10" Margin="0,4,0,8" TextWrapping="Wrap"/>
                  <StackPanel x:Name="RateLimitItemsPanel"/>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>

            <Grid x:Name="PokedexView"
                  Grid.Row="2"
                  Margin="0,8,0,6"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="2,0,2,10">
                    <TextBlock x:Name="PokedexCountText"
                               DockPanel.Dock="Right"
                               VerticalAlignment="Bottom"
                               Foreground="#FF007AFF"
                               FontSize="11"
                               Text="0종 · 0마리" />
                    <StackPanel>
                        <TextBlock Foreground="#FF202124"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="포켓몬 도감" />
                        <TextBlock Margin="0,2,0,0"
                                   Foreground="#FF737780"
                                   FontSize="10"
                                   Text="직접 만난 모습만 기록됩니다" />
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="1"
                        Margin="0,0,0,8"
                        Padding="3"
                        Background="#FFE5E5EA"
                        CornerRadius="7">
                    <UniformGrid Columns="2">
                        <Button x:Name="SpeciesModeButton"
                                Height="25"
                                Click="SpeciesModeButton_OnClick"
                                Background="#FFE5E5EA"
                                BorderThickness="0"
                                Foreground="#FF202124"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Content="종별 도감" />
                        <Button x:Name="CatchLogModeButton"
                                Height="25"
                                Click="CatchLogModeButton_OnClick"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#FF737780"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Content="포획 기록" />
                    </UniformGrid>
                </Border>
                <Grid Grid.Row="2">
                    <ScrollViewer x:Name="SpeciesScrollView"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="PokedexItemsPanel"
                                   HorizontalAlignment="Left" />
                    </ScrollViewer>
                    <ScrollViewer x:Name="CatchLogScrollView"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="Collapsed">
                        <StackPanel x:Name="CatchLogItemsPanel" />
                    </ScrollViewer>
                    <StackPanel x:Name="EmptyPokedexView"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   Foreground="#FF007AFF"
                                   FontSize="32"
                                   Text="?" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="#FF575B63"
                                   FontSize="12"
                                   Text="아직 만난 포켓몬이 없습니다" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="#FF737780"
                                   FontSize="10"
                                   Text="알이 부화하면 첫 기록이 생깁니다" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid x:Name="TokensView" Grid.Row="2" Margin="0,10,0,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <UniformGrid Columns="3">
                    <Button x:Name="TokensTodayButton" Content="TODAY" Tag="Today"
                            Style="{StaticResource ModernActionButton}" Padding="0,7"
                            Margin="0,0,3,0" Click="TokensPeriodButton_OnClick" />
                    <Button x:Name="TokensWeekButton" Content="WEEK" Tag="Week"
                            Style="{StaticResource ModernActionButton}" Padding="0,7"
                            Margin="3,0" Click="TokensPeriodButton_OnClick" />
                    <Button x:Name="TokensMonthButton" Content="MONTH" Tag="Month"
                            Style="{StaticResource ModernActionButton}" Padding="0,7"
                            Margin="3,0,0,0" Click="TokensPeriodButton_OnClick" />
                </UniformGrid>
                <StackPanel Grid.Row="1" Margin="2,12,2,10">
                    <TextBlock x:Name="TokensPeriodText" Foreground="#FF575B63" FontSize="11" />
                    <TextBlock x:Name="TokensTotalText" Foreground="#FF202124" FontSize="25"
                               FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="공급자별 사용량 · 전체 대비 비율" Foreground="#FF737780" FontSize="10" />
                </StackPanel>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="TokensEmptyText" Margin="2,12" Foreground="#FF575B63"
                                   Text="선택한 기간에 기록된 사용량이 없습니다" TextWrapping="Wrap" />
                        <ItemsControl x:Name="TokensProviderItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFF9FAFB" CornerRadius="10" Padding="12" Margin="0,0,2,8">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ShareText}"
                                                           Foreground="#FF007AFF" FontSize="11" Margin="8,0,0,0" />
                                                <TextBlock Text="{Binding Name}" Foreground="#FF202124" FontSize="12"
                                                           FontWeight="SemiBold" TextWrapping="Wrap" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding TotalText}" Foreground="#FF30333A" FontSize="16" Margin="0,5,0,7" />
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Share}" Height="5"
                                                         Foreground="#FF007AFF" Background="#FFE5E5EA" BorderThickness="0">
                                                <ProgressBar.Template>
                                                    <ControlTemplate TargetType="ProgressBar">
                                                        <Grid x:Name="PART_Track">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                                                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                                                    Background="{TemplateBinding Foreground}" CornerRadius="2" />
                                                        </Grid>
                                                    </ControlTemplate>
                                                </ProgressBar.Template>
                                            </ProgressBar>
                                            <TextBlock Text="{Binding Detail}" Visibility="{Binding DetailVisibility}"
                                                       Margin="0,8,0,0" Foreground="#FF575B63" FontSize="10" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding UpdatedText}" Foreground="#FF737780" FontSize="10" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                <TextBlock x:Name="TokensStatusText" Grid.Row="3" Margin="2,7,2,0" MaxHeight="48"
                           Foreground="#FF737780" FontSize="10" TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Grid>

            <ScrollViewer x:Name="ShopView"
                          Grid.Row="2"
                          Margin="0,10,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="Collapsed">
                <StackPanel Margin="2,0,2,4">
                    <TextBlock Foreground="#FF202124"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="포켓몬 상점" />
                    <Border Margin="0,8,0,10"
                            Padding="12"
                            Background="#FFF0F1F3"
                            BorderBrush="#FFD9DADD"
                            BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel>
                            <TextBlock Foreground="#FF81858C"
                                       FontSize="9"
                                       Text="사용 가능한 토큰" />
                            <TextBlock x:Name="ShopWalletText"
                                       Margin="0,2,0,0"
                                       Foreground="#FF202124"
                                       FontFamily="Consolas"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Text="0" />
                            <TextBlock Margin="0,2,0,0"
                                       Foreground="#FF697386"
                                       FontSize="9"
                                       Text="실제 사용량은 줄지 않으며 상점 지출만 별도로 기록됩니다" />
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="ShopItemsPanel" />
                    <Border x:Name="ShopConfirmationPanel"
                            Margin="0,2,0,8"
                            Padding="10"
                            Background="#FF263E4B"
                            BorderBrush="#FF3C8DAA"
                            BorderThickness="1"
                            CornerRadius="9"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="ShopConfirmationText"
                                       Foreground="#FF202124"
                                       FontSize="10"
                                       TextWrapping="Wrap" />
                            <StackPanel Margin="0,8,0,0"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                <Button x:Name="ConfirmPurchaseButton"
                                        Margin="0,0,6,0"
                                        Padding="10,4"
                                        Style="{StaticResource ModernActionButton}"
                                        Click="ConfirmPurchaseButton_OnClick"
                                        Content="구매 확정" />
                                <Button Padding="10,4"
                                        Style="{StaticResource ModernActionButton}"
                                        Click="CancelPurchaseButton_OnClick"
                                        Content="취소" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ShopStatusText"
                               Foreground="#FF007AFF"
                               FontSize="9" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="BagView"
                          Grid.Row="2"
                          Margin="0,10,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="Collapsed">
                <StackPanel Margin="2,0,2,4">
                    <TextBlock Foreground="#FF202124"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="가방" />
                    <TextBlock Margin="0,3,0,10"
                               Foreground="#FF737780"
                               FontSize="10"
                               Text="보유 아이템과 현재 적용 효과" />
                    <StackPanel x:Name="BagItemsPanel" />
                    <StackPanel x:Name="EmptyBagView"
                                Margin="0,50,0,0"
                                HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="36"
                                   Text="🎒" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="#FF575B63"
                                   FontSize="12"
                                   Text="아직 보유한 아이템이 없습니다" />
                    </StackPanel>
                    <Border x:Name="BagConfirmationPanel"
                            Margin="0,2,0,8"
                            Padding="10"
                            Background="#FF263E4B"
                            BorderBrush="#FF3C8DAA"
                            BorderThickness="1"
                            CornerRadius="9"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="BagConfirmationText"
                                       Foreground="#FF202124"
                                       FontSize="10"
                                       TextWrapping="Wrap" />
                            <StackPanel Margin="0,8,0,0"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                <Button Margin="0,0,6,0"
                                        Padding="10,4"
                                        Style="{StaticResource ModernActionButton}"
                                        Click="ConfirmUseButton_OnClick"
                                        Content="사용 확정" />
                                <Button Padding="10,4"
                                        Style="{StaticResource ModernActionButton}"
                                        Click="CancelUseButton_OnClick"
                                        Content="취소" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="BagStatusText"
                               Foreground="#FF007AFF"
                               FontSize="9" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="SettingsView"
                          Grid.Row="2"
                          Margin="0,10,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="Collapsed">
                <StackPanel Margin="2,0,2,4">
                    <TextBlock Foreground="#FF202124"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="Windows 설정" />
                    <TextBlock Margin="0,3,0,12"
                               Foreground="#FF737780"
                               FontSize="10"
                               Text="변경 사항은 즉시 저장되고 적용됩니다" />

                    <Border Padding="14"
                            Background="#FFF0F1F3"
                            BorderBrush="#FFD9DADD"
                            BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <CheckBox x:Name="NotificationsCheckBox"
                                          Style="{StaticResource ModernToggleCheckBox}"
                                          DockPanel.Dock="Right"
                                          VerticalAlignment="Center"
                                          Click="SettingsControls_OnChanged" />
                                <StackPanel>
                                    <TextBlock Foreground="#FF202124"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="포켓몬 알림" />
                                    <TextBlock Margin="0,2,18,0"
                                               Foreground="#FF81858C"
                                               FontSize="9"
                                               Text="부화·진화·육성 완료 알림" />
                                </StackPanel>
                            </DockPanel>

                            <Border Height="1" Margin="0,0,0,14" Background="#FFD9DADD" />

                            <DockPanel Margin="0,0,0,14">
                                <CheckBox x:Name="AlwaysOnTopCheckBox"
                                          Style="{StaticResource ModernToggleCheckBox}"
                                          DockPanel.Dock="Right"
                                          VerticalAlignment="Center"
                                          Click="SettingsControls_OnChanged" />
                                <StackPanel>
                                    <TextBlock Foreground="#FF202124"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="항상 위에 표시" />
                                    <TextBlock Margin="0,2,18,0"
                                               Foreground="#FF81858C"
                                               FontSize="9"
                                               Text="다른 창 위에 팝업을 유지합니다" />
                                </StackPanel>
                            </DockPanel>

                            <Border Height="1" Margin="0,0,0,14" Background="#FFD9DADD" />

                            <DockPanel Margin="0,0,0,14">
                                <CheckBox x:Name="LaunchAtLoginCheckBox"
                                          Style="{StaticResource ModernToggleCheckBox}"
                                          DockPanel.Dock="Right"
                                          VerticalAlignment="Center"
                                          Click="SettingsControls_OnChanged" />
                                <StackPanel>
                                    <TextBlock Foreground="#FF202124"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="로그인 시 자동 실행" />
                                    <TextBlock Margin="0,2,18,0"
                                               Foreground="#FF81858C"
                                               FontSize="9"
                                               Text="Windows 로그인 후 트레이에서 시작합니다" />
                                </StackPanel>
                            </DockPanel>

                            <Border Height="1" Margin="0,0,0,14" Background="#FFD9DADD" />

                            <DockPanel>
                                <ComboBox x:Name="RefreshIntervalComboBox"
                                          Style="{StaticResource ModernComboBox}"
                                          DockPanel.Dock="Right"
                                          Width="88"
                                          Height="26"
                                          VerticalAlignment="Center"
                                          SelectionChanged="SettingsControls_OnChanged">
                                    <ComboBoxItem Tag="30" Content="30초" />
                                    <ComboBoxItem Tag="60" Content="1분" />
                                    <ComboBoxItem Tag="120" Content="2분" />
                                    <ComboBoxItem Tag="300" Content="5분" />
                                    <ComboBoxItem Tag="600" Content="10분" />
                                </ComboBox>
                                <StackPanel>
                                    <TextBlock Foreground="#FF202124"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="자동 새로고침" />
                                    <TextBlock Margin="0,2,18,0"
                                               Foreground="#FF81858C"
                                               FontSize="9"
                                               Text="로컬 로그 확인 주기" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,10,0,0"
                            Padding="14"
                            Background="#FFF0F1F3"
                            BorderBrush="#FFD9DADD"
                            BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <CheckBox x:Name="FloatingPetCheckBox"
                                          Style="{StaticResource ModernToggleCheckBox}"
                                          DockPanel.Dock="Right"
                                          VerticalAlignment="Center"
                                          Click="SettingsControls_OnChanged" />
                                <StackPanel>
                                    <TextBlock Foreground="#FF202124"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="플로팅 펫 표시" />
                                    <TextBlock Margin="0,2,18,0"
                                               Foreground="#FF81858C"
                                               FontSize="9"
                                               Text="바탕화면 위에 동료를 띄웁니다 · 드래그로 이동" />
                                </StackPanel>
                            </DockPanel>

                            <Border Height="1" Margin="0,0,0,14" Background="#FFD9DADD" />

                            <DockPanel>
                                <ComboBox x:Name="FloatingPetSizeComboBox"
                                          Style="{StaticResource ModernComboBox}"
                                          DockPanel.Dock="Right"
                                          Width="88"
                                          Height="26"
                                          VerticalAlignment="Center"
                                          SelectionChanged="SettingsControls_OnChanged">
                                    <ComboBoxItem Tag="64" Content="작게" />
                                    <ComboBoxItem Tag="96" Content="보통" />
                                    <ComboBoxItem Tag="128" Content="크게" />
                                    <ComboBoxItem Tag="160" Content="아주 크게" />
                                </ComboBox>
                                <StackPanel>
                                    <TextBlock Foreground="#FF202124"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="플로팅 펫 크기" />
                                    <TextBlock Margin="0,2,18,0"
                                               Foreground="#FF81858C"
                                               FontSize="9"
                                               Text="우클릭하면 열기·끄기 메뉴가 나타납니다" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,10,0,0"
                            Padding="14"
                            Background="#FFF0F1F3"
                            BorderBrush="#FFD9DADD"
                            BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel>
                            <TextBlock Foreground="#FF202124"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Text="세이브 이전" />
                            <TextBlock Margin="0,2,0,10"
                                       Foreground="#FF81858C"
                                       FontSize="9"
                                       Text="진행 상황을 파일로 백업하거나 다른 PC에서 가져옵니다" />
                            <UniformGrid Columns="2">
                                <Button Margin="0,0,4,0"
                                        Style="{StaticResource ModernActionButton}"
                                        Padding="8,5"
                                        Click="ExportSaveButton_OnClick"
                                        Content="내보내기" />
                                <Button Margin="4,0,0,0"
                                        Style="{StaticResource ModernActionButton}"
                                        Padding="8,5"
                                        Click="ImportSaveButton_OnClick"
                                        Content="가져오기" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="SettingsStatusText"
                               Margin="2,10,2,0"
                               Foreground="#FF007AFF"
                               FontSize="10"
                               Text="설정을 불러왔습니다" />
                </StackPanel>
            </ScrollViewer>

            <Border x:Name="MilestoneOverlay"
                    Grid.Row="2"
                    Panel.ZIndex="20"
                    Margin="0,8,0,0"
                    Background="#EE171A21"
                    CornerRadius="12"
                    Opacity="0"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="MilestoneOverlayScale" ScaleX="0.88" ScaleY="0.88" />
                </Border.RenderTransform>
                <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="MilestoneGlyphText"
                               HorizontalAlignment="Center"
                               Foreground="#FFFACC15"
                               FontSize="42"
                               Text="★" />
                    <TextBlock x:Name="MilestoneTitleText"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               Foreground="#FF202124"
                               FontSize="22"
                               FontWeight="Bold"
                               Text="진화 성공!" />
                    <TextBlock x:Name="MilestoneDetailText"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               Foreground="#FF007AFF"
                               FontSize="13"
                               Text="새로운 모습" />
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>
