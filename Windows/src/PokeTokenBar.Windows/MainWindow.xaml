<Window x:Class="PokeTokenBar.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PokeTokenBar"
        Width="380"
        Height="500"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Padding="22"
            Background="#FF171A21"
            BorderBrush="#FF343A46"
            BorderThickness="1"
            CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal">
                    <Button x:Name="RefreshButton"
                            Width="30"
                            Height="30"
                            Margin="0,0,4,0"
                            Click="RefreshButton_OnClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#FFAEB7C7"
                            FontSize="18"
                            ToolTip="Refresh Codex usage"
                            Content="&#x21BB;" />
                    <Button Width="30"
                            Height="30"
                            Click="HideButton_OnClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#FFAEB7C7"
                            FontSize="18"
                            ToolTip="Hide to notification area"
                            Content="&#x2014;" />
                </StackPanel>
                <StackPanel Cursor="SizeAll"
                            MouseLeftButtonDown="HeaderDragRegion_OnMouseLeftButtonDown"
                            ToolTip="Drag to move PokeTokenBar">
                    <TextBlock Foreground="White"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Text="PokeTokenBar" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="#FF7DD3FC"
                               FontSize="12"
                               Text="Windows port · Codex usage" />
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1"
                    Margin="0,12,0,6"
                    Padding="3"
                    Background="#FF11141A"
                    CornerRadius="8">
                <UniformGrid Columns="5">
                    <Button x:Name="HomeTabButton"
                            Height="28"
                            Click="HomeTabButton_OnClick"
                            Background="#FF2B3440"
                            BorderThickness="0"
                            Foreground="White"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Content="HOME" />
                    <Button x:Name="PokedexTabButton"
                            Height="28"
                            Click="PokedexTabButton_OnClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#FF7D8797"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Content="POKÉDEX" />
                    <Button x:Name="ShopTabButton"
                            Height="28"
                            Click="ShopTabButton_OnClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#FF7D8797"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Content="SHOP" />
                    <Button x:Name="BagTabButton"
                            Height="28"
                            Click="BagTabButton_OnClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#FF7D8797"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Content="BAG" />
                    <Button x:Name="SettingsTabButton"
                            Height="28"
                            Click="SettingsTabButton_OnClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#FF7D8797"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Content="SETTINGS" />
                </UniformGrid>
            </Border>

            <StackPanel x:Name="HomeView"
                        Grid.Row="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Grid x:Name="CompanionVisualContainer"
                      Width="96"
                      Height="96"
                      HorizontalAlignment="Center">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="CompanionIdleTranslate" />
                    </Grid.RenderTransform>
                    <Grid x:Name="EggVisual">
                        <Path Fill="#FF1B1F27"
                          Stroke="#FFFF5A3C"
                          StrokeThickness="4"
                          Data="M 48,3 C 28,3 13,36 13,63 C 13,84 27,93 48,93 C 69,93 83,84 83,63 C 83,36 68,3 48,3 Z">
                            <Path.Effect>
                                <DropShadowEffect BlurRadius="10"
                                                  Color="#FFFF4F38"
                                                  Opacity="0.7"
                                                  ShadowDepth="0" />
                            </Path.Effect>
                        </Path>
                        <Path Stroke="#FFFF5A3C"
                          StrokeThickness="5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Data="M 26,57 L 38,47 L 48,58 L 58,45 L 71,56" />
                    </Grid>
                    <Image x:Name="PokemonImage"
                           Width="96"
                           Height="96"
                           Stretch="Uniform"
                           Visibility="Collapsed"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Grid>
                <TextBlock x:Name="CompanionTitleText"
                           Margin="0,5,0,0"
                           HorizontalAlignment="Center"
                           Foreground="#FFFF806B"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Text="새 알 · 0%" />
                <ProgressBar x:Name="CompanionProgressBar"
                             Width="180"
                             Height="6"
                             Margin="0,6,0,0"
                             Background="#FF343A46"
                             Foreground="#FFFF5A3C"
                             Maximum="1"
                             Value="0" />
                <TextBlock x:Name="CompanionProgressText"
                           Margin="0,5,0,0"
                           HorizontalAlignment="Center"
                           Foreground="#FF8F98A8"
                           FontSize="10"
                           Text="첫 사용량 동기화 후 부화를 시작합니다" />
                <StackPanel x:Name="EvolutionLinePanel"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Visibility="Collapsed" />
                <TextBlock x:Name="TokenValueText"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           Foreground="White"
                           FontFamily="Consolas"
                           FontSize="34"
                           FontWeight="Bold"
                           Text="0" />
                <TextBlock x:Name="ExactTokenValueText"
                           Margin="0,4,0,0"
                           HorizontalAlignment="Center"
                           Foreground="#FF7DD3FC"
                           FontFamily="Consolas"
                           FontSize="12"
                           Text="0" />
                <TextBlock x:Name="StatusText"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           Foreground="#FFAEB7C7"
                           Text="Codex 로그 연결 준비 중" />
                <StackPanel Margin="0,18,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock HorizontalAlignment="Center"
                                   Foreground="#FF7D8797"
                                   FontSize="11"
                                   Text="THIS WEEK" />
                        <TextBlock x:Name="WeekValueText"
                                   Margin="0,3,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="White"
                                   FontFamily="Consolas"
                                   FontSize="16"
                                   Text="0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center"
                                   Foreground="#FF7D8797"
                                   FontSize="11"
                                   Text="THIS MONTH" />
                        <TextBlock x:Name="MonthValueText"
                                   Margin="0,3,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="White"
                                   FontFamily="Consolas"
                                   FontSize="16"
                                   Text="0" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <Grid x:Name="PokedexView"
                  Grid.Row="2"
                  Margin="0,8,0,6"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="2,0,2,10">
                    <TextBlock x:Name="PokedexCountText"
                               DockPanel.Dock="Right"
                               VerticalAlignment="Bottom"
                               Foreground="#FF7DD3FC"
                               FontSize="11"
                               Text="0종 · 0마리" />
                    <StackPanel>
                        <TextBlock Foreground="White"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="포켓몬 도감" />
                        <TextBlock Margin="0,2,0,0"
                                   Foreground="#FF7D8797"
                                   FontSize="10"
                                   Text="직접 만난 모습만 기록됩니다" />
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="1"
                        Margin="0,0,0,8"
                        Padding="3"
                        Background="#FF11141A"
                        CornerRadius="7">
                    <UniformGrid Columns="2">
                        <Button x:Name="SpeciesModeButton"
                                Height="25"
                                Click="SpeciesModeButton_OnClick"
                                Background="#FF2B3440"
                                BorderThickness="0"
                                Foreground="White"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Content="종별 도감" />
                        <Button x:Name="CatchLogModeButton"
                                Height="25"
                                Click="CatchLogModeButton_OnClick"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#FF7D8797"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Content="포획 기록" />
                    </UniformGrid>
                </Border>
                <Grid Grid.Row="2">
                    <ScrollViewer x:Name="SpeciesScrollView"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="PokedexItemsPanel"
                                   HorizontalAlignment="Left" />
                    </ScrollViewer>
                    <ScrollViewer x:Name="CatchLogScrollView"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="Collapsed">
                        <StackPanel x:Name="CatchLogItemsPanel" />
                    </ScrollViewer>
                    <StackPanel x:Name="EmptyPokedexView"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   Foreground="#FF7DD3FC"
                                   FontSize="32"
                                   Text="?" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="#FFAEB7C7"
                                   FontSize="12"
                                   Text="아직 만난 포켓몬이 없습니다" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="#FF7D8797"
                                   FontSize="10"
                                   Text="알이 부화하면 첫 기록이 생깁니다" />
                    </StackPanel>
                </Grid>
            </Grid>

            <ScrollViewer x:Name="ShopView"
                          Grid.Row="2"
                          Margin="0,10,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="Collapsed">
                <StackPanel Margin="2,0,2,4">
                    <TextBlock Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="포켓몬 상점" />
                    <Border Margin="0,8,0,10"
                            Padding="12"
                            Background="#FF20242C"
                            BorderBrush="#FF343A46"
                            BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel>
                            <TextBlock Foreground="#FF8F98A8"
                                       FontSize="9"
                                       Text="사용 가능한 토큰" />
                            <TextBlock x:Name="ShopWalletText"
                                       Margin="0,2,0,0"
                                       Foreground="White"
                                       FontFamily="Consolas"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Text="0" />
                            <TextBlock Margin="0,2,0,0"
                                       Foreground="#FF697386"
                                       FontSize="9"
                                       Text="실제 사용량은 줄지 않으며 상점 지출만 별도로 기록됩니다" />
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="ShopItemsPanel" />
                    <Border x:Name="ShopConfirmationPanel"
                            Margin="0,2,0,8"
                            Padding="10"
                            Background="#FF263E4B"
                            BorderBrush="#FF3C8DAA"
                            BorderThickness="1"
                            CornerRadius="9"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="ShopConfirmationText"
                                       Foreground="White"
                                       FontSize="10"
                                       TextWrapping="Wrap" />
                            <StackPanel Margin="0,8,0,0"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                <Button x:Name="ConfirmPurchaseButton"
                                        Margin="0,0,6,0"
                                        Padding="10,4"
                                        Click="ConfirmPurchaseButton_OnClick"
                                        Content="구매 확정" />
                                <Button Padding="10,4"
                                        Click="CancelPurchaseButton_OnClick"
                                        Content="취소" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ShopStatusText"
                               Foreground="#FF7DD3FC"
                               FontSize="9" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="BagView"
                          Grid.Row="2"
                          Margin="0,10,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="Collapsed">
                <StackPanel Margin="2,0,2,4">
                    <TextBlock Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="가방" />
                    <TextBlock Margin="0,3,0,10"
                               Foreground="#FF7D8797"
                               FontSize="10"
                               Text="보유 아이템과 현재 적용 효과" />
                    <StackPanel x:Name="BagItemsPanel" />
                    <StackPanel x:Name="EmptyBagView"
                                Margin="0,50,0,0"
                                HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="36"
                                   Text="🎒" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="#FFAEB7C7"
                                   FontSize="12"
                                   Text="아직 보유한 아이템이 없습니다" />
                    </StackPanel>
                    <Border x:Name="BagConfirmationPanel"
                            Margin="0,2,0,8"
                            Padding="10"
                            Background="#FF263E4B"
                            BorderBrush="#FF3C8DAA"
                            BorderThickness="1"
                            CornerRadius="9"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="BagConfirmationText"
                                       Foreground="White"
                                       FontSize="10"
                                       TextWrapping="Wrap" />
                            <StackPanel Margin="0,8,0,0"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                <Button Margin="0,0,6,0"
                                        Padding="10,4"
                                        Click="ConfirmUseButton_OnClick"
                                        Content="사용 확정" />
                                <Button Padding="10,4"
                                        Click="CancelUseButton_OnClick"
                                        Content="취소" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="BagStatusText"
                               Foreground="#FF7DD3FC"
                               FontSize="9" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="SettingsView"
                          Grid.Row="2"
                          Margin="0,10,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="Collapsed">
                <StackPanel Margin="2,0,2,4">
                    <TextBlock Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="Windows 설정" />
                    <TextBlock Margin="0,3,0,12"
                               Foreground="#FF7D8797"
                               FontSize="10"
                               Text="변경 사항은 즉시 저장되고 적용됩니다" />

                    <Border Padding="14"
                            Background="#FF20242C"
                            BorderBrush="#FF343A46"
                            BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <CheckBox x:Name="NotificationsCheckBox"
                                          DockPanel.Dock="Right"
                                          VerticalAlignment="Center"
                                          Click="SettingsControls_OnChanged" />
                                <StackPanel>
                                    <TextBlock Foreground="White"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="포켓몬 알림" />
                                    <TextBlock Margin="0,2,18,0"
                                               Foreground="#FF8F98A8"
                                               FontSize="9"
                                               Text="부화·진화·육성 완료 알림" />
                                </StackPanel>
                            </DockPanel>

                            <Border Height="1" Margin="0,0,0,14" Background="#FF343A46" />

                            <DockPanel Margin="0,0,0,14">
                                <CheckBox x:Name="AlwaysOnTopCheckBox"
                                          DockPanel.Dock="Right"
                                          VerticalAlignment="Center"
                                          Click="SettingsControls_OnChanged" />
                                <StackPanel>
                                    <TextBlock Foreground="White"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="항상 위에 표시" />
                                    <TextBlock Margin="0,2,18,0"
                                               Foreground="#FF8F98A8"
                                               FontSize="9"
                                               Text="다른 창 위에 팝업을 유지합니다" />
                                </StackPanel>
                            </DockPanel>

                            <Border Height="1" Margin="0,0,0,14" Background="#FF343A46" />

                            <DockPanel Margin="0,0,0,14">
                                <CheckBox x:Name="LaunchAtLoginCheckBox"
                                          DockPanel.Dock="Right"
                                          VerticalAlignment="Center"
                                          Click="SettingsControls_OnChanged" />
                                <StackPanel>
                                    <TextBlock Foreground="White"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="로그인 시 자동 실행" />
                                    <TextBlock Margin="0,2,18,0"
                                               Foreground="#FF8F98A8"
                                               FontSize="9"
                                               Text="Windows 로그인 후 트레이에서 시작합니다" />
                                </StackPanel>
                            </DockPanel>

                            <Border Height="1" Margin="0,0,0,14" Background="#FF343A46" />

                            <DockPanel>
                                <ComboBox x:Name="RefreshIntervalComboBox"
                                          DockPanel.Dock="Right"
                                          Width="88"
                                          Height="26"
                                          VerticalAlignment="Center"
                                          SelectionChanged="SettingsControls_OnChanged">
                                    <ComboBoxItem Tag="1" Content="1분" />
                                    <ComboBoxItem Tag="2" Content="2분" />
                                    <ComboBoxItem Tag="5" Content="5분" />
                                    <ComboBoxItem Tag="10" Content="10분" />
                                    <ComboBoxItem Tag="30" Content="30분" />
                                </ComboBox>
                                <StackPanel>
                                    <TextBlock Foreground="White"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="자동 새로고침" />
                                    <TextBlock Margin="0,2,18,0"
                                               Foreground="#FF8F98A8"
                                               FontSize="9"
                                               Text="Codex 로그 확인 주기" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="SettingsStatusText"
                               Margin="2,10,2,0"
                               Foreground="#FF7DD3FC"
                               FontSize="10"
                               Text="설정을 불러왔습니다" />
                </StackPanel>
            </ScrollViewer>

            <Border x:Name="MilestoneOverlay"
                    Grid.Row="2"
                    Panel.ZIndex="20"
                    Margin="0,8,0,0"
                    Background="#EE171A21"
                    CornerRadius="12"
                    Opacity="0"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="MilestoneOverlayScale" ScaleX="0.88" ScaleY="0.88" />
                </Border.RenderTransform>
                <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="MilestoneGlyphText"
                               HorizontalAlignment="Center"
                               Foreground="#FFFACC15"
                               FontSize="42"
                               Text="★" />
                    <TextBlock x:Name="MilestoneTitleText"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"
                               Text="진화 성공!" />
                    <TextBlock x:Name="MilestoneDetailText"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               Foreground="#FF7DD3FC"
                               FontSize="13"
                               Text="새로운 모습" />
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>
