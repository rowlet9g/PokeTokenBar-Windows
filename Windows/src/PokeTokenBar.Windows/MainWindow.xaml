<Window x:Class="PokeTokenBar.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PokeTokenBar"
        Width="380"
        Height="500"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Padding="22"
            Background="#FF171A21"
            BorderBrush="#FF343A46"
            BorderThickness="1"
            CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal">
                    <Button x:Name="RefreshButton"
                            Width="30"
                            Height="30"
                            Margin="0,0,4,0"
                            Click="RefreshButton_OnClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#FFAEB7C7"
                            FontSize="18"
                            ToolTip="Refresh Codex usage"
                            Content="&#x21BB;" />
                    <Button Width="30"
                            Height="30"
                            Click="HideButton_OnClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#FFAEB7C7"
                            FontSize="18"
                            ToolTip="Hide to notification area"
                            Content="&#x2014;" />
                </StackPanel>
                <StackPanel Cursor="SizeAll"
                            MouseLeftButtonDown="HeaderDragRegion_OnMouseLeftButtonDown"
                            ToolTip="Drag to move PokeTokenBar">
                    <TextBlock Foreground="White"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Text="PokeTokenBar" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="#FF7DD3FC"
                               FontSize="12"
                               Text="Windows port · Codex usage" />
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1"
                    Margin="0,12,0,6"
                    Padding="3"
                    Background="#FF11141A"
                    CornerRadius="8">
                <UniformGrid Columns="2">
                    <Button x:Name="HomeTabButton"
                            Height="28"
                            Click="HomeTabButton_OnClick"
                            Background="#FF2B3440"
                            BorderThickness="0"
                            Foreground="White"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Content="HOME" />
                    <Button x:Name="PokedexTabButton"
                            Height="28"
                            Click="PokedexTabButton_OnClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#FF7D8797"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Content="POKÉDEX" />
                </UniformGrid>
            </Border>

            <StackPanel x:Name="HomeView"
                        Grid.Row="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Grid Width="96"
                      Height="96"
                      HorizontalAlignment="Center">
                    <Grid x:Name="EggVisual">
                        <Path Fill="#FF1B1F27"
                          Stroke="#FFFF5A3C"
                          StrokeThickness="4"
                          Data="M 48,3 C 28,3 13,36 13,63 C 13,84 27,93 48,93 C 69,93 83,84 83,63 C 83,36 68,3 48,3 Z">
                            <Path.Effect>
                                <DropShadowEffect BlurRadius="10"
                                                  Color="#FFFF4F38"
                                                  Opacity="0.7"
                                                  ShadowDepth="0" />
                            </Path.Effect>
                        </Path>
                        <Path Stroke="#FFFF5A3C"
                          StrokeThickness="5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Data="M 26,57 L 38,47 L 48,58 L 58,45 L 71,56" />
                    </Grid>
                    <Image x:Name="PokemonImage"
                           Width="96"
                           Height="96"
                           Stretch="Uniform"
                           Visibility="Collapsed"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Grid>
                <TextBlock x:Name="CompanionTitleText"
                           Margin="0,5,0,0"
                           HorizontalAlignment="Center"
                           Foreground="#FFFF806B"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Text="새 알 · 0%" />
                <ProgressBar x:Name="CompanionProgressBar"
                             Width="180"
                             Height="6"
                             Margin="0,6,0,0"
                             Background="#FF343A46"
                             Foreground="#FFFF5A3C"
                             Maximum="1"
                             Value="0" />
                <TextBlock x:Name="CompanionProgressText"
                           Margin="0,5,0,0"
                           HorizontalAlignment="Center"
                           Foreground="#FF8F98A8"
                           FontSize="10"
                           Text="첫 사용량 동기화 후 부화를 시작합니다" />
                <StackPanel x:Name="EvolutionLinePanel"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Visibility="Collapsed" />
                <TextBlock x:Name="TokenValueText"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           Foreground="White"
                           FontFamily="Consolas"
                           FontSize="34"
                           FontWeight="Bold"
                           Text="0" />
                <TextBlock x:Name="ExactTokenValueText"
                           Margin="0,4,0,0"
                           HorizontalAlignment="Center"
                           Foreground="#FF7DD3FC"
                           FontFamily="Consolas"
                           FontSize="12"
                           Text="0" />
                <TextBlock x:Name="StatusText"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           Foreground="#FFAEB7C7"
                           Text="Codex 로그 연결 준비 중" />
                <StackPanel Margin="0,18,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock HorizontalAlignment="Center"
                                   Foreground="#FF7D8797"
                                   FontSize="11"
                                   Text="THIS WEEK" />
                        <TextBlock x:Name="WeekValueText"
                                   Margin="0,3,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="White"
                                   FontFamily="Consolas"
                                   FontSize="16"
                                   Text="0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center"
                                   Foreground="#FF7D8797"
                                   FontSize="11"
                                   Text="THIS MONTH" />
                        <TextBlock x:Name="MonthValueText"
                                   Margin="0,3,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="White"
                                   FontFamily="Consolas"
                                   FontSize="16"
                                   Text="0" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <Grid x:Name="PokedexView"
                  Grid.Row="2"
                  Margin="0,8,0,6"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="2,0,2,10">
                    <TextBlock x:Name="PokedexCountText"
                               DockPanel.Dock="Right"
                               VerticalAlignment="Bottom"
                               Foreground="#FF7DD3FC"
                               FontSize="11"
                               Text="0종 · 0마리" />
                    <StackPanel>
                        <TextBlock Foreground="White"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="포켓몬 도감" />
                        <TextBlock Margin="0,2,0,0"
                                   Foreground="#FF7D8797"
                                   FontSize="10"
                                   Text="직접 만난 모습만 기록됩니다" />
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="1"
                        Margin="0,0,0,8"
                        Padding="3"
                        Background="#FF11141A"
                        CornerRadius="7">
                    <UniformGrid Columns="2">
                        <Button x:Name="SpeciesModeButton"
                                Height="25"
                                Click="SpeciesModeButton_OnClick"
                                Background="#FF2B3440"
                                BorderThickness="0"
                                Foreground="White"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Content="종별 도감" />
                        <Button x:Name="CatchLogModeButton"
                                Height="25"
                                Click="CatchLogModeButton_OnClick"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#FF7D8797"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Content="포획 기록" />
                    </UniformGrid>
                </Border>
                <Grid Grid.Row="2">
                    <ScrollViewer x:Name="SpeciesScrollView"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="PokedexItemsPanel"
                                   HorizontalAlignment="Left" />
                    </ScrollViewer>
                    <ScrollViewer x:Name="CatchLogScrollView"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="Collapsed">
                        <StackPanel x:Name="CatchLogItemsPanel" />
                    </ScrollViewer>
                    <StackPanel x:Name="EmptyPokedexView"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   Foreground="#FF7DD3FC"
                                   FontSize="32"
                                   Text="?" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="#FFAEB7C7"
                                   FontSize="12"
                                   Text="아직 만난 포켓몬이 없습니다" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="#FF7D8797"
                                   FontSize="10"
                                   Text="알이 부화하면 첫 기록이 생깁니다" />
                    </StackPanel>
                </Grid>
            </Grid>

            <StackPanel Grid.Row="3">
                <Border Height="1" Margin="0,0,0,14" Background="#FF343A46" />
                <TextBlock Foreground="#FF7D8797"
                           FontSize="11"
                           Text="Windows data directory" />
                <TextBlock x:Name="StoragePathText"
                           Margin="0,4,0,0"
                           Foreground="#FFAEB7C7"
                           FontFamily="Consolas"
                           FontSize="11"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="PersistenceErrorText"
                           Margin="0,5,0,0"
                           Foreground="#FFFF806B"
                           FontSize="9"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
