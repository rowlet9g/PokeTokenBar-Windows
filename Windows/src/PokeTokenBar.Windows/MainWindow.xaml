<Window x:Class="PokeTokenBar.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PokeTokenBar"
        Width="380"
        Height="500"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Padding="22"
            Background="#FF171A21"
            BorderBrush="#FF343A46"
            BorderThickness="1"
            CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <Button DockPanel.Dock="Right"
                        Width="30"
                        Height="30"
                        Click="HideButton_OnClick"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#FFAEB7C7"
                        FontSize="18"
                        Content="&#x2715;" />
                <StackPanel>
                    <TextBlock Foreground="White"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Text="PokeTokenBar" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="#FF7DD3FC"
                               FontSize="12"
                               Text="Windows port · first milestone" />
                </StackPanel>
            </DockPanel>

            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock HorizontalAlignment="Center"
                           FontSize="76"
                           Text="&#x1F95A;" />
                <TextBlock x:Name="TokenValueText"
                           Margin="0,16,0,0"
                           HorizontalAlignment="Center"
                           Foreground="White"
                           FontFamily="Consolas"
                           FontSize="34"
                           FontWeight="Bold"
                           Text="0" />
                <TextBlock Margin="0,6,0,0"
                           HorizontalAlignment="Center"
                           Foreground="#FFAEB7C7"
                           Text="Codex 로그 연결 준비 중" />
            </StackPanel>

            <StackPanel Grid.Row="2">
                <Border Height="1" Margin="0,0,0,14" Background="#FF343A46" />
                <TextBlock Foreground="#FF7D8797"
                           FontSize="11"
                           Text="Windows data directory" />
                <TextBlock x:Name="StoragePathText"
                           Margin="0,4,0,0"
                           Foreground="#FFAEB7C7"
                           FontFamily="Consolas"
                           FontSize="11"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
